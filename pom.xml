<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方 parent，统一依赖版本与插件配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.shana</groupId>
    <artifactId>shana</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>shana</name>
    <description>Java AI 应用平台：群聊 AI 助手</description>

    <modules>
        <module>shana-common</module>
        <module>shana-model</module>
        <module>shana-rag</module>
        <module>shana-report</module>
        <module>shana-core</module>
        <module>shana-infrastructure</module>
        <module>shana-memory</module>
        <module>shana-agent</module>
        <module>shana-channel-qq</module>
        <module>shana-api</module>
        <module>shana-application</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Spring Boot BOM 不管理 MyBatis-Plus，这里显式锁定版本 -->
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块：统一版本号，子模块引用时无需写 version -->
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-rag</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-report</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-agent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-channel-qq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.shana</groupId>
                <artifactId>shana-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方：MyBatis-Plus（Spring Boot 3 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 3.5.9 起分页插件拆分到该模块，缺少它分页会在运行期失败 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有模块共享的开发期依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            IDEA / Eclipse 内置 JUnit 运行器需要通过 Launcher API 启动测试，
            而 spring-boot-starter-test 不包含它（Maven Surefire 用自带的 provider，所以
            mvn test 能跑，IDE 里却报 Failed to resolve junit-platform-launcher）。
            版本由 Spring Boot BOM 经 junit-bom 统一管理，这里不写版本号。
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!-- 保留方法参数名：@Value / @RequestParam 等依赖参数名解析 -->
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
