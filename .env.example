# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，禁止提交真实密码

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shana
DB_USER=shana
DB_PASSWORD=change-me-postgres

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# ---------- 对话模型（可选，为空时问答接口返回 503） ----------
SHANA_LLM_BASE_URL=https://api.deepseek.com/v1
SHANA_LLM_MODEL=deepseek-chat
SHANA_LLM_API_KEY=

# ---------- 向量化模型（可选，为空时 RAG 不启用） ----------
# 注意：DeepSeek 没有 /embeddings，这里必须指向另一家（硅基流动 / 阿里百炼 / OpenAI / 本地 vLLM）
SHANA_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SHANA_EMBEDDING_MODEL=BAAI/bge-m3
SHANA_EMBEDDING_API_KEY=
# 必须与数据库 vector(N) 一致；改这里等于要重建向量表
SHANA_EMBEDDING_DIM=1024

# ---------- 应用 ----------
SERVER_PORT=8080
