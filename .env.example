# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，禁止提交真实密码

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shana
DB_USER=shana
DB_PASSWORD=change-me-postgres

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# ---------- 对话模型（可选，为空时问答接口返回 503） ----------
SHANA_LLM_BASE_URL=https://api.deepseek.com/v1
SHANA_LLM_MODEL=deepseek-chat
SHANA_LLM_API_KEY=

# ---------- 向量化模型（可选，为空时 RAG 不启用） ----------
# 注意：DeepSeek 没有 /embeddings，这里必须指向另一家（硅基流动 / 阿里百炼 / OpenAI / 本地 vLLM）
SHANA_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SHANA_EMBEDDING_MODEL=BAAI/bge-m3
SHANA_EMBEDDING_API_KEY=
# 必须与数据库 vector(N) 一致；改这里等于要重建向量表
SHANA_EMBEDDING_DIM=1024

# ---------- QQ 渠道（可选，默认关闭） ----------
# 需要一个已扫码登录的 NapCat，并在其 WebUI 里新建「WebSocket 服务器」
SHANA_QQ_ENABLED=false
SHANA_QQ_WS_URL=ws://127.0.0.1:3001
SHANA_QQ_ACCESS_TOKEN=
# 群聊是否必须 @ 机器人才回复
SHANA_QQ_REQUIRE_AT=true
# 逗号分隔的群号 / QQ 号白名单，留空表示不限制
SHANA_QQ_GROUPS=
SHANA_QQ_USERS=

# ---------- 应用 ----------
SERVER_PORT=8080
