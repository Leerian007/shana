<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shana</groupId>
        <artifactId>shana</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>shana-model</artifactId>
    <name>shana-model</name>
    <description>统一大模型调用接口与适配层（当前只提供接口与路由，不绑定厂商）</description>

    <dependencies>
        <dependency>
            <groupId>com.shana</groupId>
            <artifactId>shana-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- 适配器解析上游 JSON 需要，版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 只用 RestClient 做 HTTP 调用，不引入 Web 容器；版本由 Boot BOM 管理 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
    </dependencies>
</project>
