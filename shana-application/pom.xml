<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shana</groupId>
        <artifactId>shana</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>shana-application</artifactId>
    <name>shana-application</name>
    <description>启动模块：装配所有模块并提供应用配置，唯一可执行 jar</description>

    <dependencies>
        <dependency>
            <groupId>com.shana</groupId>
            <artifactId>shana-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shana</groupId>
            <artifactId>shana-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shana</groupId>
            <artifactId>shana-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shana</groupId>
            <artifactId>shana-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shana</groupId>
            <artifactId>shana-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shana</groupId>
            <artifactId>shana-agent</artifactId>
        </dependency>
        <!-- QQ 渠道默认关闭（shana.qq.enabled=false），引入它只是为了打成一个包时能就地打开 -->
        <dependency>
            <groupId>com.shana</groupId>
            <artifactId>shana-channel-qq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 只有启动模块需要打成可执行 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.shana.application.ShanaApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
